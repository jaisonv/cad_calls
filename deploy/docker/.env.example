# Telegram Bot Token (required)
# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# CAD API Configuration (required)
CAD_BASE_URL=https://your-agency.policetocitizen.com
CAD_AGENCY_ID=0

# Bot Settings (optional)
CHECK_INTERVAL=5
VERIFY_SSL=false

# Optional: Comma-separated Telegram user IDs allowed to run /users
# Example: ADMIN_USER_IDS=123456789,987654321
ADMIN_USER_IDS=
